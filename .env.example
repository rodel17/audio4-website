# Copy to .env and adjust as needed.
FRONTEND_PORT=3000
BACKEND_PORT=8000

# Database credentials. Change POSTGRES_PASSWORD for production.
POSTGRES_USER=audio4
POSTGRES_PASSWORD=audio4
POSTGRES_DB=audio4

# First admin account, created on first start only.
# Leave ADMIN_PASSWORD empty to have a random one generated and printed in the backend logs.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=

# Set to true when the site is served over HTTPS (marks the admin session cookie Secure).
COOKIE_SECURE=false

# Comma-separated origins allowed to call the backend directly from a browser.
CORS_ORIGINS=http://localhost:3000

# Optional: SMTP server for inquiry notification emails. Leave SMTP_HOST empty to disable.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
