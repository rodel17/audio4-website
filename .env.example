# Copy to .env and adjust as needed. Never commit .env (it's in .gitignore).
# Avoid "$" in any value: Docker Compose treats it as a variable.

# ---------- Production only (the server) ----------
# Your domain, pointed at the server's IP. Caddy gets the HTTPS certificate for it automatically.
SITE_ADDRESS=
# Lets you run plain `docker compose ...` on the server instead of adding -f flags every time.
# COMPOSE_FILE=compose.yaml:compose.prod.yaml

# ---------- Database ----------
# Required in production. Use letters and numbers only (it's part of a connection URL), e.g. the
# output of: openssl rand -hex 24
# Postgres reads it only when the database is first created, so set it BEFORE the first start.
POSTGRES_USER=audio4
POSTGRES_PASSWORD=audio4
POSTGRES_DB=audio4

# ---------- First admin account (created on first start only) ----------
# Leave ADMIN_PASSWORD empty to have a random one generated and printed once in the backend logs.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=

# Admin cookie is HTTPS-only. Defaults to true in production (compose.prod.yaml) and false in dev.
# COOKIE_SECURE=

# ---------- Email (optional) ----------
# SMTP server for inquiry notifications. Leave SMTP_HOST empty to disable. Example for Resend:
#   SMTP_HOST=smtp.resend.com  SMTP_USER=resend  SMTP_PASSWORD="re_..."
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# ---------- Development only ----------
FRONTEND_PORT=3000
BACKEND_PORT=8000
# Postgres for pgAdmin etc. on localhost (5433 avoids a locally installed PostgreSQL on 5432).
DB_PORT=5433
